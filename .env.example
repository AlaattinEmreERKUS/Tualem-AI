# PostgreSQL
POSTGRES_DB=tualem_db
POSTGRES_USER=tualem_user
POSTGRES_PASSWORD=<güçlü-şifre>
POSTGRES_HOST=localhost
POSTGRES_PORT=5430

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<güçlü-şifre>

# Redis
REDIS_PASSWORD=<güçlü-şifre>
REDIS_URL=redis://:şifre@localhost:6375/0

# JWT
JWT_SECRET=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# LLM — birini seçin (GROQ, OLLAMA veya OPENROUTER)
LLM_PROVIDER=openrouter

# OpenRouter (varsayılan)
OPENROUTER_API_KEY=
EXTRACTION_MODEL=openai/gpt-4o-mini

# JWT (tüm modüller arasında paylaşılan secret — min 32 karakter)
JWT_SECRET=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Django settings (her modül için ayrı ya da aynı key kullanılabilir)
DJANGO_SECRET_KEY=<güçlü-rastgele-key>
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (frontend origin'leri)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# LLM — birini seçin (openrouter, groq, ollama)
LLM_PROVIDER=openrouter

# Groq (alternatif)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (alternatif, yerel)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
